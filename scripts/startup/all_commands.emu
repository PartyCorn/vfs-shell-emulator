# Стартовый скрипт: все команды и режимы (этапы 1-5), запускать на VFS deep
# --- служебная команда и текущий каталог
vfs-info
pwd
# --- ls: обычный, -a, -l, путь, файл, несколько путей
ls
ls -a
ls -l
ls docs src
ls docs/guide.txt
# --- cd: относительный путь, .., абсолютный путь, без аргумента
cd docs/api
pwd
ls
cd ../..
cd /src/app
ls -l
cd
# --- find: без аргументов, -name, -type, путь, оба условия
find docs
find -name "*.txt"
find src -type d
find / -type f -name "spec*"
# --- du: по умолчанию, -s, -h, -a, файл
du docs
du -s docs
du -sh docs
du -a src
du docs/guide.txt
# --- head: по умолчанию, -n, несколько файлов
head docs/guide.txt
head -n 1 docs/api/v1/spec.txt docs/api/v2/spec.txt
# --- touch и cp (этап 5)
touch new.txt
cp -r docs docs_copy
cp motd docs_copy
find docs_copy -type f
# --- ошибки
touch nodir/x.txt
cp nothing x
ls nothing
ls -z
cd docs/guide.txt
cd nothing
cd a b
find nothing
find -type x
du nothing
head docs
head nothing
head -n x docs/guide.txt
head
unknown_command arg
ls "незакрытая кавычка
# после ошибок диалог продолжается
pwd
